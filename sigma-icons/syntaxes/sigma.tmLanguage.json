{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Sigma",
  "scopeName": "source.sigma",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#function-def" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#builtins" },
    { "include": "#calls" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.block.sigma", "begin": "^\\s*---(?!-)", "end": "---" },
        { "name": "comment.line.double-dash.sigma", "match": "--.*$" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.sigma",
          "begin": "\"", "end": "\"",
          "patterns": [{ "include": "#escapes" }, { "include": "#interpolation" }]
        },
        {
          "name": "string.quoted.single.sigma",
          "begin": "'", "end": "'",
          "patterns": [{ "include": "#escapes" }, { "include": "#interpolation" }]
        }
      ]
    },
    "escapes": { "name": "constant.character.escape.sigma", "match": "\\\\[ntr0\\\\\"'{}]" },
    "interpolation": {
      "name": "meta.interpolation.sigma",
      "begin": "\\{", "end": "\\}",
      "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.sigma" } },
      "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.sigma" } },
      "patterns": [{ "include": "$self" }]
    },
    "function-def": {
      "match": "\\b(cook)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.function.sigma" },
        "2": { "name": "entity.name.function.sigma" }
      }
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.conditional.sigma", "match": "\\b(fr|nah)\\b" },
        { "name": "keyword.control.loop.sigma", "match": "\\b(grind|in|dip|skip)\\b" },
        { "name": "keyword.control.flow.sigma", "match": "\\b(serve)\\b" },
        { "name": "keyword.control.exception.sigma", "match": "\\b(yolo|oops|yeet)\\b" },
        { "name": "keyword.control.import.sigma", "match": "\\b(yoink)\\b" },
        { "name": "storage.modifier.sigma", "match": "\\b(lock|cook)\\b" },
        { "name": "keyword.operator.logical.sigma", "match": "\\b(and|or|not)\\b" }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.boolean.sigma", "match": "\\b(true|false|nocap|cap)\\b" },
        { "name": "constant.language.nil.sigma", "match": "\\bnil\\b" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.sigma", "match": "\\b0[xX][0-9A-Fa-f_]+\\b" },
        { "name": "constant.numeric.decimal.sigma", "match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*)?([eE][+-]?[0-9]+)?\\b" }
      ]
    },
    "builtins": {
      "name": "support.function.builtin.sigma",
      "match": "\\b(yap|ask|len|type|num|int|str|abs|floor|ceil|round|sqrt|pow|min|max|rand|rand_int|now|sleep|args|exit|read_file|write_file|append_file|file_exists|vibecheck)(?=\\s*\\()"
    },
    "calls": {
      "patterns": [
        { "match": "\\.([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()", "captures": { "1": { "name": "support.function.method.sigma" } } },
        { "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()", "captures": { "1": { "name": "entity.name.function.call.sigma" } } }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "storage.type.function.arrow.sigma", "match": "=>" },
        { "name": "keyword.operator.range.sigma", "match": "\\.\\.=?" },
        { "name": "keyword.operator.assignment.compound.sigma", "match": "\\+=|-=|\\*=|/=|%=|\\+\\+" },
        { "name": "keyword.operator.comparison.sigma", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.arithmetic.sigma", "match": "\\*\\*|\\+|-|\\*|/|%" },
        { "name": "keyword.operator.logical.sigma", "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.assignment.sigma", "match": ":" }
      ]
    }
  }
}
